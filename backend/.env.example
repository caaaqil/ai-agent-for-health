# ===== Backend environment =====
PORT=5000

# MongoDB. Local: mongodb://localhost:27017/health-assistant
# Production: a MongoDB Atlas connection string (https://www.mongodb.com/atlas)
MONGO_URI=mongodb://localhost:27017/health-assistant

# Which AI backend to use: "ollama" (local) or "groq" (production)
AI_PROVIDER=groq

# --- Ollama (local dev only) ---
OLLAMA_URL=http://localhost:11434/api/generate
AI_MODEL=phi3:latest
AI_VISION_MODEL=llava

# --- Groq (production) --- free key: https://console.groq.com
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
